generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum BannerType {
  HERO
  PROMOTIONAL
  POPUP
}

model User {
  id            String         @id @default(cuid())
  role          UserRole       @default(CUSTOMER)
  name          String
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  sessions      Session[]
  activityLogs  ActivityLog[]  @relation("ActorLogs")
}

model Category {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  sku              String           @unique
  barcode          String?          @unique
  shortDescription String?          @db.Text
  description      String?          @db.LongText
  specifications   Json?
  price            Decimal          @db.Decimal(12, 2)
  salePrice        Decimal?         @db.Decimal(12, 2)
  stock            Int              @default(0)
  weightGrams      Int?
  status           ProductStatus    @default(DRAFT)
  isFeatured       Boolean          @default(false)
  isNewArrival     Boolean          @default(false)
  categoryId       String
  brandId          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         Category         @relation(fields: [categoryId], references: [id])
  brand            Brand?           @relation(fields: [brandId], references: [id])
  images           ProductImage[]
  tags             ProductTag[]
  orderItems       OrderItem[]
  reviews          Review[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  variants         ProductVariant[]
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  name       String
  stock      Int         @default(0)
  isSoldOut  Boolean     @default(false)
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId, position])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  url        String
  publicId   String?
  alt        String?
  position   Int     @default(0)
  isFeatured Boolean @default(false)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  address   String   @db.Text
  area      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  customerId      String
  addressId       String?
  status          OrderStatus          @default(PENDING)
  paymentMethod   PaymentMethod
  subtotal        Decimal              @db.Decimal(12, 2)
  discountAmount  Decimal              @default(0) @db.Decimal(12, 2)
  deliveryCharge  Decimal              @default(0) @db.Decimal(12, 2)
  total           Decimal              @db.Decimal(12, 2)
  notes           String?              @db.Text
  couponId        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  stockRestoredAt DateTime?
  deliveryZone    DeliveryZone         @default(INSIDE_DHAKA)
  customer        User                 @relation(fields: [customerId], references: [id])
  address         Address?             @relation(fields: [addressId], references: [id])
  coupon          Coupon?              @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  history         OrderStatusHistory[]

  @@index([status, createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String?
  quantity    Int
  unitPrice   Decimal         @db.Decimal(12, 2)
  productName String
  variantId   String?
  variantName String?
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review      Review?
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?      @db.Text
  type        DiscountType
  amount      Decimal      @db.Decimal(12, 2)
  usageLimit  Int?
  usedCount   Int          @default(0)
  startsAt    DateTime     @default(now())
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  orders      Order[]
}

model Review {
  id          String     @id @default(cuid())
  userId      String
  productId   String
  rating      Int
  comment     String?    @db.Text
  isVisible   Boolean    @default(true)
  orderItemId String?    @unique
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

enum DeliveryZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
  SPECIAL
}

model DeliveryCharge {
  id              String       @id @default(cuid())
  zone            DeliveryZone @unique
  label           String
  amount          Decimal      @db.Decimal(12, 2)
  isEnabled       Boolean      @default(true)
  scheduledAmount Decimal?     @db.Decimal(12, 2)
  scheduledAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Banner {
  id                  String     @id @default(cuid())
  type                BannerType
  title               String?
  imageUrl            String
  imagePublicId       String?
  mobileImageUrl      String?
  mobileImagePublicId String?
  mainHeading         String?
  subHeading          String?
  description         String?    @db.Text
  offerText           String?
  secondaryText       String?
  buttonText          String?
  linkUrl             String?
  position            Int        @default(0)
  startsAt            DateTime?
  endsAt              DateTime?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model WebsiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  isEnabled Boolean  @default(true)
  position  Int      @default(0)
  config    Json?
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  title     String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
